{
  "servers": {
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--with", "mcp<1.10", "mcp-server-fetch"]
    },
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "envFile": "${workspaceFolder}/.env"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
